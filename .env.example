# Copy to .env.local for development. In Vercel, add these under Project Settings > Environment Variables.
TURSO_DATABASE_URL=libsql://card-vault-<you>.turso.io   # unset locally = file:local.db
TURSO_AUTH_TOKEN=
GROQ_API_KEY=
GROQ_VISION_MODEL=      # a current Groq vision model, e.g. meta-llama/llama-4-scout-17b-16e-instruct
GROQ_CHAT_MODEL=        # a current Groq tool-calling model, e.g. openai/gpt-oss-120b
